{
  "name": "bebras-process-judge",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint:types": "tsc -b --pretty false",
    "setup": "node scripts/setup-supabase.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "check:content": "node scripts/check-content.mjs",
    "supabase:login": "npx --yes supabase@latest login",
    "supabase:link": "npx --yes supabase@latest link",
    "supabase:push": "npx --yes supabase@latest db push",
    "supabase:push:dry": "npx --yes supabase@latest db push --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
